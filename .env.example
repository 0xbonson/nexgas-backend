# ============================================================================
# NEX-GAS Backend — Environment Variables Configuration
# Copy this file to .env and fill in your values.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ============================================================================

# HTTP Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (SQLite)
DB_PATH=./data/nexgas.sqlite

# MQTT Broker (HiveMQ Cloud TLS)
# Obtain your cluster URL and credentials from HiveMQ Cloud Console -> Access Management
MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID_PREFIX=nexgas-backend
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000

# Target Device Filtering
DEFAULT_DEVICE_ID=nexgas-001

# CORS Allowed Origins (comma-separated, no wildcards for commands)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nex-gas.github.io

# Command Rate Limiting
RATE_LIMIT_COMMAND_MAX=10
RATE_LIMIT_COMMAND_WINDOW_MS=10000

# Optional: Set to 'true' to auto-connect to MQTT broker on startup
MQTT_CONNECT_ON_STARTUP=false

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
