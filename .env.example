# ============================================================================
# NEX-GAS Backend — Environment Variables Configuration
# Copy this file to .env and fill in your values.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ============================================================================

# HTTP Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Supported drivers: 'sqlite' (local file/WAL) or 'turso' (Turso Cloud libSQL)
DATABASE_DRIVER=sqlite
DB_PATH=./data/nexgas.sqlite

# Turso Cloud Database Configuration (used when DATABASE_DRIVER=turso)
# Example: libsql://nexgas-db-yourname.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Security & Authentication (JWT & RBAC)
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=nexgas-default-dev-secret-key-32-chars-minimum!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# MQTT Broker Configuration
# For production (HiveMQ Cloud TLS Port 8883):
MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID_PREFIX=nexgas-backend
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000

# Auto-connect to MQTT on server startup ('true' or 'false')
MQTT_CONNECT_ON_STARTUP=true

# PUBLIC MQTT TEST MODE (CRITICAL SAFETY GUARD)
# Set to 'true' during public broker testing / demonstrations.
# When true: ALL incoming actuator commands (valve, tare, mode, calibrations)
# are strictly blocked with HTTP 403 Forbidden to prevent unauthorized hardware actuation.
PUBLIC_MQTT_TEST_MODE=true

# Target Device Filtering
DEFAULT_DEVICE_ID=nexgas-001

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nex-gas.github.io

# Command Rate Limiting
RATE_LIMIT_COMMAND_MAX=10
RATE_LIMIT_COMMAND_WINDOW_MS=10000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
