# ============================================================================
# NEX-GAS Backend — Production Cloud Deployment Environment Variables
# Configure these variables in your Cloud Hosting Dashboard (Render, Railway, etc.)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ============================================================================

# HTTP Server Configuration
NODE_ENV=production
PORT=5001

# Database Configuration (Turso Cloud)
DATABASE_DRIVER=turso
TURSO_DATABASE_URL=libsql://nexgas-db-0xbonson.aws-ap-southeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# MQTT Broker Configuration
# For HiveMQ Public Broker (demonstration/test):
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=nexgas-backend-cloud
MQTT_CONNECT_ON_STARTUP=true

# CRITICAL SAFETY GUARD: Remote actuator commands strictly blocked on public broker
PUBLIC_MQTT_TEST_MODE=true

# Target Device Filtering
DEFAULT_DEVICE_ID=nexgas-001

# CORS Allowed Origins (Comma-separated list of your frontend URLs)
# Example: https://nexgas.pages.dev,https://nex-gas.github.io,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://nex-gas.github.io,https://nexgas.pages.dev

# Security & Authentication (JWT & RBAC)
# Must be at least 32 characters long, generated securely: openssl rand -base64 32
JWT_SECRET=generate_a_secure_random_32_char_secret_here!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000

