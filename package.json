{
  "name": "nex-gas-backend",
  "version": "1.0.0",
  "description": "NEX-GAS anaerobic digestion and biogas monitoring system backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts",
    "turso:migrate": "tsx src/cli/turso-migrate.ts",
    "turso:import": "tsx src/cli/turso-import-sqlite.ts",
    "tunnel:start": "bash scripts/start-tunnel.sh",
    "tunnel:stop": "bash scripts/stop-tunnel.sh"
  },
  "keywords": [
    "nexgas",
    "biogas",
    "mqtt",
    "iot",
    "esp32",
    "hivemq"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "mqtt": "^5.16.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
